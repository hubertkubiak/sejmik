<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent (aggregator) POM: builds all modules and holds the shared configuration -->
    <groupId>pl.hubert</groupId>
    <artifactId>liberum-veto-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Liberum Veto</name>
    <description>Symulator sejmiku szlacheckiego: turowa gra w Javie 21</description>

    <!-- Maven sorts modules by their dependencies, so domain is always built before console -->
    <modules>
        <module>domain</module>
        <module>console</module>
        <module>api</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.2.0</spring-boot.version>
        <springdoc.version>3.2.1</springdoc.version>
        <jackson.version>2.23.0</jackson.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>

        <compiler.plugin.version>3.16.0</compiler.plugin.version>
        <surefire.plugin.version>3.6.1</surefire.plugin.version>
        <jar.plugin.version>3.5.1</jar.plugin.version>
        <shade.plugin.version>3.6.2</shade.plugin.version>
        <jacoco.plugin.version>0.8.16</jacoco.plugin.version>
    </properties>

    <!-- dependencyManagement only fixes versions; a module still has to declare the dependency itself -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pl.hubert</groupId>
                <artifactId>liberum-veto-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Plain <dependencies> in the parent ARE inherited: every module gets the test libraries -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- pluginManagement: plugin versions and defaults, activated per module -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${shade.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- plugins: active in every module -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <!-- keep parameter names in bytecode: Spring reads them via reflection (e.g. @PathVariable UUID id) -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>
            <plugin>
                <!-- every module gets a coverage report; the 80% rule is set only in domain -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
