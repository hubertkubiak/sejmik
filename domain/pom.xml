<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pl.hubert</groupId>
        <artifactId>liberum-veto-parent</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <!-- groupId and version are inherited from the parent -->
    <artifactId>liberum-veto-domain</artifactId>
    <name>Liberum Veto :: Domain</name>
    <description>Game rules in plain Java: no frameworks, no I/O, no runtime dependencies</description>

    <!-- Deliberately no <dependencies>: the domain only gets JUnit and AssertJ (test scope) from the parent -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the build fails if domain line coverage drops below 80% -->
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
